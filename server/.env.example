# ===== 搴旂敤閰嶇疆 =====
NODE_ENV=development
PORT=10310

# ===== 鏁版嵁搴?=====
DATABASE_URL="mysql://root:password@localhost:3306/infrared_cloud"

# ===== JWT =====
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===== 瀵嗙爜鍝堝笇 =====
BCRYPT_SALT_ROUNDS=10

# ===== Turnstile (Cloudflare) =====
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY_REGISTER=1x0000000000000000000000000000000AA
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# ===== 璁惧閰嶇疆 =====
DEVICE_TOKEN_LENGTH=32
HEARTBEAT_TIMEOUT_SECONDS=300

# ===== 鏁版嵁淇濈暀 =====
DATA_RETENTION_DAYS=90

# ===== 瓒呯骇绠＄悊鍛?(seed 鑴氭湰浣跨敤) =====
SEED_ADMIN_EMAIL=admin@infrared-cloud.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ===== OneBot (鍒濆閰嶇疆锛屼篃鍙湪绠＄悊鍚庡彴淇敼) =====
ONEBOT_WS_URL=ws://127.0.0.1:8080
ONEBOT_TOKEN=

# ===== 閫熺巼闄愬埗 =====
RATE_LIMIT_AUTH=5
RATE_LIMIT_REPORT=60

# ===== 固件版本管理 =====
# 固件 bin 落盘目录（生产建议指向 server_old 下的 firmware_store）
FIRMWARE_STORE_DIR=./firmware_store
# 单个固件最大字节数（默认 4MB）
FIRMWARE_MAX_SIZE=4194304

# ===== 鍥轰欢鐗堟湰绠＄悊 (OTA) =====
# 鍥轰欢 bin 鏂囦欢瀛樺偍鐩綍锛堢粷瀵硅矾寰勶級
FIRMWARE_STORE_DIR=/www/wwwroot/pir.xiaoyyua.top/server_old/firmware_store
# 鍗曚釜鍥轰欢涓婁紶涓婇檺锛堝瓧鑺傦級锛岄粯璁 4MB
FIRMWARE_MAX_SIZE=4194304

# ===== 固件版本管理（云端 OTA / Web 端刷写）=====
# 固件 bin 落盘目录
FIRMWARE_STORE_DIR=/www/wwwroot/pir.xiaoyyua.top/server_old/firmware_store
# 单个固件文件大小上限（字节），默认 4MB
FIRMWARE_MAX_SIZE=4194304

# ===== 支付 (Epay 彩虹易支付) =====
# 易支付 API 地址
EPAY_API_URL=https://your-epay.example.com
# 易支付商户 ID
EPAY_PID=1
# 易支付 MD5 签名密钥
EPAY_KEY=your-epay-md5-key
# 会员价格（元）
MEMBERSHIP_PRICE=1

# ===== OIDC (auth.xiaoyyua.top) =====
OIDC_ISSUER=https://auth.xiaoyyua.top
OIDC_CLIENT_ID=pir-cloud
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_REDIRECT_URI=https://pir.xiaoyyua.top/api/auth/oidc/callback
OIDC_SCOPES=openid profile qq

# ===== Alist 对象存储 =====
ALIST_BASE_URL=https://alist.xiaoyyua.top
ALIST_API_TOKEN=your-alist-api-token
ALIST_FIRMWARE_PATH=/S3-Rainyun-18376752486(11323)/alist1/guest/pir_download

# ===== QQ 验证 =====
QQ_VERIFY_EXPIRE_MINUTES=30
QQ_VERIFY_SECRET=your-qq-verify-secret
QQ_VERIFY_BOT_QQ=2472900895

# ===== Web 前端 =====
WEB_URL=https://pir.xiaoyyua.top
